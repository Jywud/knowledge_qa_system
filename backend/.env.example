DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_qa
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_data
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
RETRIEVAL_MIN_SCORE=0.5
MAX_HISTORY_MESSAGES=20
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# 在线 Embedding（OpenAI 兼容协议，例如阿里云百炼）
EMBED_PROVIDER=ollama
EMBED_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_OPENAI_API_KEY=
EMBED_OPENAI_DIMENSIONS=1024
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_API_KEY=your-api-key
LLM_MODEL=deepseek-v4.1-flash
JWT_SECRET=your-random-secret
JWT_EXPIRE_HOURS=24

# 登录防暴力破解
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
