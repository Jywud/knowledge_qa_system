# ===== 数据库与存储 =====
# PostgreSQL 连接串：用户:密码@主机:端口/库名
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_qa
# 上传文件保存目录（相对 backend/）
UPLOAD_DIR=uploads

# ===== 分块与检索参数（新建库首次初始化时作种子值，之后以设置页 SystemSetting 为准） =====
# 单个文本分块的最大字符数
CHUNK_SIZE=800
# 相邻分块之间保留的重复字符数
CHUNK_OVERLAP=100
# 每路召回（向量检索/关键词检索各算一路）的候选条数
TOP_K=30
# RRF 融合后保留的候选条数（开启语义重排时即为重排候选池大小）
RRF_TOP_N=20
# 语义重排后送入大模型的知识块条数（重排关闭时不生效）
TOP_N=5
# 向量召回的相关度下限（cosine 相似度阈值，低于该值的候选不进入融合）
RETRIEVAL_MIN_SCORE=0.5
# chat 节点每次送大模型的最近消息条数上限，更早的滚动压缩为摘要
MAX_HISTORY_MESSAGES=20
# 遗留配置：当前代码未读取（摘要触发由 MAX_HISTORY_MESSAGES 与 SUMMARY_BATCH_SIZE 决定）
SUMMARY_TRIGGER_MESSAGES=30
# 待压缩的旧消息达到该条数才调用一次摘要，避免频繁触发
SUMMARY_BATCH_SIZE=10
# 单文件上传大小上限（MB）
MAX_UPLOAD_MB=50

# ===== Ollama 本地 Embedding =====
# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434
# Embedding 模型名；已生成向量的维度与模型绑定，换模型需清空 chunks 重建
EMBED_MODEL=bge-m3

# ===== 在线 Embedding（OpenAI 兼容协议，例如阿里云百炼） =====
# ollama | openai，二选一
EMBED_PROVIDER=ollama
# OpenAI 兼容协议地址
EMBED_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_OPENAI_API_KEY=
# 指定输出向量维度（需与库中已有向量维度一致，留空使用模型默认）
EMBED_OPENAI_DIMENSIONS=1024

# ===== 语义重排（当前支持 DashScope text-rerank 协议） =====
# none | dashscope，none 时不调用，设置页开启重排也会按融合顺序降级
RERANK_PROVIDER=none
# 重排模型名
RERANK_MODEL=gte-rerank-v2
RERANK_API_KEY=
# 服务根地址（客户端自动拼接 /api/v1/... 路径）
RERANK_BASE_URL=https://dashscope.aliyuncs.com

# ===== 大模型（OpenAI 兼容协议，可替换为其他供应商） =====
# 模型服务地址
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 模型服务 API Key
LLM_API_KEY=your-api-key
# 模型名称（问答、摘要、标题生成共用）
LLM_MODEL=deepseek-v4.1-flash

# ===== 登录认证（JWT） =====
# token 签名密钥，生产环境必须更换为随机长字符串
JWT_SECRET=your-random-secret
# token 有效期（小时）
JWT_EXPIRE_HOURS=24
# 连续登录失败次数上限，超过后锁定账号
LOGIN_MAX_ATTEMPTS=5
# 锁定时长（分钟）
LOGIN_LOCK_MINUTES=15
# 仅信任明确的代理地址；Docker Compose 会覆盖为专用前端代理 IP
TRUSTED_PROXY_IPS=127.0.0.1,::1
